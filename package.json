{
  "name": "vesper-ceremony",
  "private": true,
  "type": "module",
  "description": "Multi-party trusted setup (Groth16 phase 2) for the Vesper transaction circuit",
  "scripts": {
    "contribute": "node scripts/contribute.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "verify:final": "node scripts/verify-final.mjs",
    "init": "node scripts/init.mjs",
    "finalize": "node scripts/finalize.mjs",
    "check-circuit": "bash scripts/check-circuit.sh"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "circomlib": "2.0.5",
    "snarkjs": "0.7.6"
  }
}
